<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F3F8FF"
    android:padding="20dp">



    <TextView

        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="GrowSureTech"
        android:textSize="32sp"
        android:textStyle="bold"
        android:textColor="#1565F9"
        android:layout_gravity="center"
        android:layout_marginTop="20dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Welcome to Smart Child Growth Monitoring"
        android:textSize="14sp"
        android:textColor="#666666"
        android:layout_gravity="center"
        android:layout_marginTop="5dp"/>

    <!-- Role Selection -->

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Role of You"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#1565F9"
        android:layout_marginTop="50dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Please select your role to proceed"
        android:textSize="14sp"
        android:textColor="#666666"
        android:layout_marginTop="5dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Select Role *"
        android:textStyle="bold"
        android:textColor="#333333"
        android:layout_marginTop="25dp"/>

    <Spinner
        android:id="@+id/spRole"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:layout_marginTop="10dp"/>

    <Button
        android:id="@+id/btnProceed"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="PROCEED"
        android:textStyle="bold"
        android:textSize="18sp"
        android:textColor="#FFFFFF"
        android:backgroundTint="#1565F9"
        android:layout_marginTop="30dp"/>
    ```


</LinearLayout>